# ─────────────────────────────────────────────────────────────
#  .env.production.example — Environment Variables
#  Copy this to your VPS directory as .env
#  Example: cp .env.production.example .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

# Docker registry namespace / username (e.g., your dockerhub username)
DOCKER_USERNAME=grocery
IMAGE_TAG=latest

# MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_DB_NAME=columbu_stores

# JWT Secret
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_KEY_FOR_JWT
JWT_EXPIRE=7d

# Domain or IP where your app is hosted (e.g. http://your-vps-ip or https://yourdomain.com)
FRONTEND_URL=http://localhost
